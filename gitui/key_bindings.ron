// "" 
// "SHIFT"
// "CONTROL"
// "ALT"
//
// Note:
// If the default key layout is lower case,
// and you want to use `Shift + q` to trigger the exit event,
// the setting should like this `exit: Some(( code: Char('Q'), modifiers: "SHIFT")),`
// The Char should be upper case.
//
// Note:
// find `KeysList` type in src/keys/key_list.rs for all possible keys.
// every key not overwritten via the config file will use the default specified there
(
	focus_left: Some(( code: Char('n'), modifiers: "")),
	focus_below: Some(( code: Char('e'), modifiers: "")),
	focus_above: Some(( code: Char('i'), modifiers: "")),
	focus_right: Some(( code: Char('o'), modifiers: "")),

	open_commit_editor: Some(( code: Char('e'), modifiers: "CONTROL")),
	open_help: Some(( code: Char('h'), modifiers: "CONTROL")),
	open_options: Some(( code: Char('o'), modifiers: "CONTROL")),
	
	move_left: Some(( code: Char('n'), modifiers: "")),
	move_down: Some(( code: Char('e'), modifiers: "")),
	move_up: Some(( code: Char('i'), modifiers: "")),
	move_right: Some(( code: Char('o'), modifiers: "")),

	popup_down: Some(( code: Char('e'), modifiers: "")),
	popup_up: Some(( code: Char('i'), modifiers: "")),
	page_down: Some(( code: Char(','), modifiers: "CONTROL")),
	page_up: Some(( code: Char('.'), modifiers: "CONTROL")),
	home: Some(( code: Char('g'), modifiers: "")),
	end: Some(( code: Char('G'), modifiers: "SHIFT")),
	shift_down: Some(( code: Char('u'), modifiers: "CONTROL")),
	shift_up: Some(( code: Char('y'), modifiers: "CONTROL")),

	file_history: Some(( code: Char('H'), modifiers: "SHIFT")),
	edit_file: Some(( code: Char('E'), modifiers: "SHIFT")),

	status_reset_item: Some(( code: Char('U'), modifiers: "SHIFT")),
	status_ignore_file: Some(( code: Char('I'), modifiers: "SHIFT")),

	diff_reset_lines: Some(( code: Char('u'), modifiers: "")),
	diff_stage_lines: Some(( code: Char('s'), modifiers: "")),

	stashing_save: Some(( code: Char('w'), modifiers: "")),
	stashing_toggle_index: Some(( code: Char('m'), modifiers: "")),

	stash_open: Some(( code: Char('o'), modifiers: "")),

	abort_merge: Some(( code: Char('M'), modifiers: "SHIFT")),

	exit_popup: Some(( code: Char('q'), modifiers: "CONTROL" )),
	quit: Some(( code: Esc, modifiers: "")),
)
